# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Magic-link email. Prefer Brevo if you do not have a domain:
# 1. https://app.brevo.com → Settings → Senders → add EMAIL_FROM and verify the code
# 2. Settings → SMTP & API → API Keys → create a key
# https://help.brevo.com/hc/en-us/articles/208836149
BREVO_API_KEY=
EMAIL_FROM="Rhythm <you@gmail.com>"

# Resend alternative. Test from: Rhythm <onboarding@resend.dev>
# Until you verify a domain, only the email on your Resend account can receive mail.
# RESEND_API_KEY=

# Optional SMTP fallback (Gmail app password, or Brevo smtp-relay.brevo.com)
# EMAIL_SERVER=smtp://user:pass@smtp.gmail.com:587

# Protects /api/cron/* (also set in Vercel project → Cron → Secret)
CRON_SECRET=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com


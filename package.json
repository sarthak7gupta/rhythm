    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "disposable-email-domains": "^1.0.62",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "i18next": "^26.4.2",
